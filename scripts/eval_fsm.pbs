#!/bin/bash
#PBS -N fsm-eval
#PBS -P personal-hlee052
#PBS -q normal
#PBS -l select=1:ngpus=2
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -r n
#PBS -o /scratch/users/ntu/hlee052/robomme_policy_learning/runs/evaluation/job.log

# Full run of FrameSamp+Modul: 16 tasks, 50 attempts each.
# -r n stops PBS restarting this by itself if a node goes down. Rerun it with
# qsub after checking what happened; eval.py resumes from progress.json.

export SCRATCH=/scratch/users/ntu/$USER
export PATH="$HOME/.local/bin:$PATH"
export UV_CACHE_DIR=$SCRATCH/.cache/uv
export MAMBA_ROOT_PREFIX=$SCRATCH/micromamba
export OPENPI_DATA_HOME=$SCRATCH/openpi
export HF_HOME=$SCRATCH/hf
export PYTHONUNBUFFERED=1

REPO=$SCRATCH/robomme_policy_learning
SAVE_DIR=runs/evaluation
CKPT=runs/ckpts/mme_vla_suite/perceptual-framesamp-modul/79999
PORT=$((20000 + RANDOM % 10000))

module load git
cd "$REPO"
echo "node: $(hostname)  job: $PBS_JOBID  code: $(git rev-parse --short HEAD)  port: $PORT"
nvidia-smi -L

# Node readings every 5 s, to show what was happening if the node goes down
while true; do
    date
    free -g | sed -n 2p
    df -h /tmp /dev/shm | tail -2
    nvidia-smi --query-gpu=index,temperature.gpu,power.draw,memory.used,utilization.gpu,ecc.errors.uncorrected.volatile.total \
        --format=csv,noheader
    ps -eo rss,pcpu,comm --sort=-rss | head -4
    dmesg -T 2>&1 | tail -3
    sync
    sleep 5
done >> $SAVE_DIR/node.log 2>&1 &
RECORDER_PID=$!

: > $SAVE_DIR/serve.log
CUDA_VISIBLE_DEVICES=0 uv run scripts/serve_policy.py --seed=7 --port=$PORT policy:checkpoint \
    --policy.dir=$CKPT --policy.config=mme_vla_suite >> $SAVE_DIR/serve.log 2>&1 &
SERVER_PID=$!

until grep -q 'Creating server' $SAVE_DIR/serve.log; do
    kill -0 $SERVER_PID 2>/dev/null || { echo "ERROR: policy server stopped"; kill $RECORDER_PID; exit 1; }
    sleep 10
done
echo "policy server ready"

eval "$(micromamba shell hook -s bash)" && micromamba activate robomme

CUDA_VISIBLE_DEVICES=1 VK_ICD_FILENAMES=/etc/vulkan/icd.d/nvidia_icd.json \
    python -u examples/robomme/eval.py \
    --args.host=127.0.0.1 --args.port=$PORT --args.model_seed=7 \
    --args.policy_name=perceptual-framesamp-modul --args.model_ckpt_id=79999 \
    --args.save_dir=$SAVE_DIR >> $SAVE_DIR/eval.log 2>&1
echo "eval exit code: $?"

kill $SERVER_PID $RECORDER_PID
